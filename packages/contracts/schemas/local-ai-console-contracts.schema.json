{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-ai-console.invalid/contracts/v1/local-ai-console-contracts.schema.json",
  "title": "Local AI Console shared architecture contracts",
  "description": "Canonical language-neutral contracts for Local AI Console.",
  "oneOf": [
    { "$ref": "#/$defs/modelProfile" },
    { "$ref": "#/$defs/generationPreset" },
    { "$ref": "#/$defs/contextPolicy" },
    { "$ref": "#/$defs/modeProfile" },
    { "$ref": "#/$defs/promptWorkflowProfile" },
    { "$ref": "#/$defs/promptProject" },
    { "$ref": "#/$defs/promptSession" },
    { "$ref": "#/$defs/promptProjectState" },
    { "$ref": "#/$defs/promptRevision" },
    { "$ref": "#/$defs/promptResponse" },
    { "$ref": "#/$defs/taskContext" },
    { "$ref": "#/$defs/taskRouting" },
    { "$ref": "#/$defs/searchProvider" },
    { "$ref": "#/$defs/searchRequest" },
    { "$ref": "#/$defs/searchResponse" },
    { "$ref": "#/$defs/hostProfile" },
    { "$ref": "#/$defs/providerCapabilities" },
    { "$ref": "#/$defs/runtimeCompatibilityRecord" },
    { "$ref": "#/$defs/promptContextContribution" },
    { "$ref": "#/$defs/knowledgeNamespace" },
    { "$ref": "#/$defs/knowledgeReference" },
    { "$ref": "#/$defs/skillProfile" },
    { "$ref": "#/$defs/toolDefinition" },
    { "$ref": "#/$defs/promptWorkbenchResponse" }
  ],
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "runtimeSlot": {
      "type": "string",
      "enum": ["main", "utility"]
    },
    "runtimeTargetPreference": {
      "type": "string",
      "enum": ["auto", "main", "utility"]
    },
    "runtimeSlotAvailability": {
      "type": "string",
      "enum": ["available", "unavailable"]
    },
    "taskKind": {
      "type": "string",
      "enum": ["chat", "prompt_generation", "context_compression"]
    },
    "contextMode": {
      "type": "string",
      "enum": ["native_shift", "manual", "llm_compact"]
    },
    "promptWorkflowMode": {
      "type": "string",
      "enum": ["stable", "balanced", "detailed", "preserve"]
    },
    "promptResponseKind": {
      "type": "string",
      "enum": ["discussion", "revision", "clarification"]
    },
    "searchMode": {
      "type": "string",
      "enum": ["off", "manual", "auto"]
    },
    "platform": {
      "type": "string",
      "enum": ["windows", "linux"]
    },
    "capabilityStatus": {
      "type": "string",
      "enum": ["supported", "unsupported", "partial", "inferred", "unverified", "unavailable"]
    },
    "contextStability": {
      "type": "string",
      "enum": ["stable", "snapshot", "append_only", "dynamic"]
    },
    "toolPermissionClass": {
      "type": "string",
      "enum": ["read_only", "local_write", "remote_write", "destructive"]
    },
    "toolApprovalPolicy": {
      "type": "string",
      "enum": ["auto", "confirm", "disabled"]
    },
    "runtimeAffinityScope": {
      "type": "string",
      "enum": ["conversation"]
    },
    "namespaceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:/[a-z0-9][a-z0-9_-]*)*$"
    },
    "capabilityEvidence": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "tested_at": { "type": "string", "format": "date-time" },
        "metadata": { "$ref": "#/$defs/extensions" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "capabilityAssessment": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/capabilityStatus" },
        "notes": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/capabilityEvidence" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "providerCapabilitySet": {
      "type": "object",
      "properties": {
        "streaming": { "$ref": "#/$defs/capabilityAssessment" },
        "structured_output": { "$ref": "#/$defs/capabilityAssessment" },
        "native_chat_token_count": { "$ref": "#/$defs/capabilityAssessment" },
        "reasoning_transport": { "$ref": "#/$defs/capabilityAssessment" },
        "thinking_toggle": { "$ref": "#/$defs/capabilityAssessment" },
        "reasoning_budget": { "$ref": "#/$defs/capabilityAssessment" },
        "realtime_reasoning_end": { "$ref": "#/$defs/capabilityAssessment" },
        "client_stream_cancel": { "$ref": "#/$defs/capabilityAssessment" },
        "server_generation_cancel": { "$ref": "#/$defs/capabilityAssessment" },
        "timings": { "$ref": "#/$defs/capabilityAssessment" },
        "prompt_cache": { "$ref": "#/$defs/capabilityAssessment" },
        "vision": { "$ref": "#/$defs/capabilityAssessment" },
        "tool_calling": { "$ref": "#/$defs/capabilityAssessment" },
        "model_lifecycle": { "$ref": "#/$defs/capabilityAssessment" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "providerCacheTiming": {
      "type": "object",
      "properties": {
        "cached_input_tokens": { "type": "integer", "minimum": 0 },
        "uncached_input_tokens": { "type": "integer", "minimum": 0 },
        "reuse_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "performanceTiming": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "prompt_time_ms": { "type": "number", "minimum": 0 },
        "generation_time_ms": { "type": "number", "minimum": 0 },
        "time_to_first_event_ms": { "type": "number", "minimum": 0 },
        "time_to_first_content_ms": { "type": "number", "minimum": 0 },
        "total_time_ms": { "type": "number", "minimum": 0 },
        "prompt_tokens_per_second": { "type": "number", "minimum": 0 },
        "generation_tokens_per_second": { "type": "number", "minimum": 0 },
        "provider_cache": { "$ref": "#/$defs/providerCacheTiming" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "contextContributionSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "content"],
          "properties": {
            "kind": { "const": "inline_text" },
            "content": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reference"],
          "properties": {
            "kind": { "const": "reference" },
            "reference": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "instructionSource": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "$ref": "#/$defs/stableId" },
        "reference": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "toolPermission": {
      "type": "object",
      "required": ["permission_class", "approval_policy"],
      "properties": {
        "permission_class": { "$ref": "#/$defs/toolPermissionClass" },
        "approval_policy": { "$ref": "#/$defs/toolApprovalPolicy" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "toolResultLimits": {
      "type": "object",
      "properties": {
        "max_result_bytes": { "type": "integer", "minimum": 1 },
        "max_result_tokens": { "type": "integer", "minimum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "toolExecutorReference": {
      "type": "object",
      "required": ["kind", "reference"],
      "properties": {
        "kind": { "$ref": "#/$defs/stableId" },
        "reference": { "type": "string", "minLength": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "runtimeAffinityHint": {
      "type": "object",
      "required": ["scope", "key"],
      "properties": {
        "scope": { "$ref": "#/$defs/runtimeAffinityScope" },
        "key": { "type": "string", "minLength": 1 },
        "target_preference": { "$ref": "#/$defs/runtimeTargetPreference" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "modelLocation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "external_path" },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "reference"],
          "properties": {
            "kind": { "const": "external_reference" },
            "reference": { "$ref": "#/$defs/stableId" }
          },
          "additionalProperties": false
        }
      ]
    },
    "modelStartup": {
      "type": "object",
      "required": ["context_size"],
      "properties": {
        "context_size": { "type": "integer", "minimum": 1 },
        "gpu_placement": { "$ref": "#/$defs/extensions" },
        "kv_cache": { "$ref": "#/$defs/extensions" },
        "batch_size": { "type": "integer", "minimum": 1 },
        "flash_attention": { "type": "boolean" },
        "parallelism": { "type": "integer", "minimum": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "modelCapabilities": {
      "type": "object",
      "required": [
        "supports_thinking",
        "supports_reasoning_budget",
        "supports_system_prompt",
        "supports_native_context_shift",
        "supports_images",
        "supports_tools"
      ],
      "properties": {
        "supports_thinking": { "type": "boolean" },
        "supports_reasoning_budget": { "type": "boolean" },
        "supports_system_prompt": { "type": "boolean" },
        "supports_native_context_shift": { "type": "boolean" },
        "supports_images": { "type": "boolean" },
        "supports_tools": { "type": "boolean" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "generationDefaults": {
      "type": "object",
      "required": ["generation_preset_id"],
      "properties": {
        "generation_preset_id": { "$ref": "#/$defs/stableId" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "reasoningDefaults": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "budget": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "modelProfile": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "id",
        "display_name",
        "backend",
        "model_location",
        "startup",
        "generation_defaults",
        "capabilities",
        "extensions"
      ],
      "properties": {
        "contract_type": { "const": "model_profile" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/stableId" },
        "display_name": { "$ref": "#/$defs/displayName" },
        "backend": { "$ref": "#/$defs/stableId" },
        "model_location": { "$ref": "#/$defs/modelLocation" },
        "startup": { "$ref": "#/$defs/modelStartup" },
        "generation_defaults": { "$ref": "#/$defs/generationDefaults" },
        "capabilities": { "$ref": "#/$defs/modelCapabilities" },
        "request_adapter": {
          "anyOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "generationPreset": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "id",
        "display_name",
        "max_output_tokens",
        "temperature",
        "top_p",
        "top_k",
        "min_p",
        "repeat_penalty",
        "seed",
        "reasoning_defaults",
        "extensions"
      ],
      "properties": {
        "contract_type": { "const": "generation_preset" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/stableId" },
        "display_name": { "$ref": "#/$defs/displayName" },
        "max_output_tokens": { "type": "integer", "minimum": 1 },
        "temperature": { "type": "number", "minimum": 0 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "top_k": { "type": "integer", "minimum": 0 },
        "min_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "repeat_penalty": { "type": "number", "exclusiveMinimum": 0 },
        "seed": { "type": ["integer", "null"] },
        "stop_strings": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "reasoning_defaults": { "$ref": "#/$defs/reasoningDefaults" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "contextTokenTarget": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "token_budget" },
        "value": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "contextPolicy": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "id",
        "display_name",
        "mode",
        "notice_threshold",
        "urgent_threshold",
        "safety_threshold",
        "confirmation_required",
        "recent_raw_keep_target",
        "summary_target",
        "compression_task_target",
        "extensions"
      ],
      "properties": {
        "contract_type": { "const": "context_policy" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/stableId" },
        "display_name": { "$ref": "#/$defs/displayName" },
        "mode": { "$ref": "#/$defs/contextMode" },
        "notice_threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "urgent_threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "safety_threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "confirmation_required": { "type": "boolean" },
        "recent_raw_keep_target": { "$ref": "#/$defs/contextTokenTarget" },
        "summary_target": { "$ref": "#/$defs/contextTokenTarget" },
        "compression_task_target": { "$ref": "#/$defs/runtimeTargetPreference" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "llm_compact" } },
            "required": ["mode"]
          },
          "then": {
            "properties": { "confirmation_required": { "const": true } }
          }
        }
      ],
      "additionalProperties": false
    },
    "taskRoutingPreference": {
      "type": "object",
      "required": ["task_kind", "target_preference", "required_capabilities", "metadata", "extensions"],
      "properties": {
        "task_kind": { "$ref": "#/$defs/taskKind" },
        "target_preference": { "$ref": "#/$defs/runtimeTargetPreference" },
        "required_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "model_profile_id": { "$ref": "#/$defs/stableId" },
        "metadata": { "$ref": "#/$defs/extensions" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "taskContext": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "task_kind",
        "target_preference",
        "required_capabilities",
        "metadata",
        "extensions"
      ],
      "properties": {
        "contract_type": { "const": "task_context" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "task_kind": { "$ref": "#/$defs/taskKind" },
        "target_preference": { "$ref": "#/$defs/runtimeTargetPreference" },
        "required_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "model_profile_id": { "$ref": "#/$defs/stableId" },
        "runtime_affinity_hint": { "$ref": "#/$defs/runtimeAffinityHint" },
        "metadata": { "$ref": "#/$defs/extensions" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "taskRouting": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "task_kind",
        "target_preference",
        "required_capabilities",
        "metadata",
        "extensions"
      ],
      "properties": {
        "contract_type": { "const": "task_routing" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "task_kind": { "$ref": "#/$defs/taskKind" },
        "target_preference": { "$ref": "#/$defs/runtimeTargetPreference" },
        "required_capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "model_profile_id": { "$ref": "#/$defs/stableId" },
        "metadata": { "$ref": "#/$defs/extensions" },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "modeProfile": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "id",
        "display_name",
        "mode_kind",
        "preferred_model_profile_id",
        "generation_preset_id",
        "context_policy_id",
        "task_routing_preferences",
        "ui_module_id",
        "capability_requirements",
        "extensions"
      ],
      "properties": {
        "contract_type": { "const": "mode_profile" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/stableId" },
        "display_name": { "$ref": "#/$defs/displayName" },
        "mode_kind": { "$ref": "#/$defs/stableId" },
        "preferred_model_profile_id": { "$ref": "#/$defs/stableId" },
        "generation_preset_id": { "$ref": "#/$defs/stableId" },
        "context_policy_id": { "$ref": "#/$defs/stableId" },
        "task_routing_preferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/taskRoutingPreference" }
        },
        "ui_module_id": { "$ref": "#/$defs/stableId" },
        "capability_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "workflowSystemComponent": {
      "type": "object",
      "required": ["id", "kind", "reference"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "kind": { "$ref": "#/$defs/stableId" },
        "reference": { "$ref": "#/$defs/stableId" }
      },
      "additionalProperties": false
    },
    "knowledgeSourceDeclaration": {
      "type": "object",
      "required": ["id", "label", "source_kind", "reference", "stability"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "label": { "$ref": "#/$defs/displayName" },
        "source_kind": { "type": "string", "enum": ["built_in", "private_runtime"] },
        "reference": { "type": "string", "minLength": 1 },
        "stability": { "$ref": "#/$defs/contextStability" },
        "token_budget": { "type": "integer", "minimum": 1 },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "promptWorkflowModeInstructions": {
      "type": "object",
      "required": ["stable", "balanced", "detailed", "preserve"],
      "properties": {
        "stable": { "type": "string", "minLength": 1 },
        "balanced": { "type": "string", "minLength": 1 },
        "detailed": { "type": "string", "minLength": 1 },
        "preserve": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "promptWorkflowProfile": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "id",
        "display_name",
        "preferred_model_profile_id",
        "fallback_target_preference",
        "supported_modes",
        "default_mode",
        "system_components",
        "knowledge_source_references",
        "example_source_references",
        "capabilities",
        "extensions"
      ],
      "properties": {
        "contract_type": { "const": "prompt_workflow_profile" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/stableId" },
        "display_name": { "$ref": "#/$defs/displayName" },
        "preferred_model_profile_id": { "$ref": "#/$defs/stableId" },
        "fallback_target_preference": { "$ref": "#/$defs/runtimeTargetPreference" },
        "supported_modes": {
          "type": "array",
          "items": { "$ref": "#/$defs/promptWorkflowMode" },
          "uniqueItems": true,
          "minItems": 1
        },
        "default_mode": { "$ref": "#/$defs/promptWorkflowMode" },
        "system_components": {
          "type": "array",
          "items": { "$ref": "#/$defs/workflowSystemComponent" }
        },
        "knowledge_source_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "example_source_references": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "output_contract_ref": { "$ref": "#/$defs/stableId" },
        "parameter_schema_ref": { "$ref": "#/$defs/stableId" },
        "skill_profile_id": { "$ref": "#/$defs/stableId" },
        "model_family": { "type": "string", "minLength": 1 },
        "workflow_instructions": { "type": "string", "minLength": 1 },
        "mode_instructions": { "$ref": "#/$defs/promptWorkflowModeInstructions" },
        "knowledge_sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/knowledgeSourceDeclaration" },
          "uniqueItems": true
        },
        "private_knowledge_namespace": { "$ref": "#/$defs/namespaceId" },
        "capabilities": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" },
          "uniqueItems": true
        },
        "extensions": { "$ref": "#/$defs/extensions" }
      },
      "additionalProperties": false
    },
    "promptProject": {
      "type": "object",
      "required": [
        "contract_type",
        "schema_version",
        "id",
        "title",
        "workflow_profile_id",
        "created_at",
        "updated_at",
        "active_session_id",
        "current_revision_id",
        "extensions"
      ],
      "properties": {
